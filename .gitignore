# elwaseet - Combined .gitignore for Spring Boot + React

# ==================== JAVA / SPRING BOOT ====================

# Compiled class files
*.class
*.jar
*.war
*.ear
target/
build/

# Maven - KEEP wrapper files
# target/ already covered above

# Gradle
.gradle/
gradle/
gradlew
gradlew.bat

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# VS Code
.vscode/

# Spring Boot - Be specific about which properties to ignore
application-local.properties
application-dev.properties
!application.properties
!application-example.properties
!application-*.example.properties

# Logs
*.log
logs/
spring.log

# Temporary files
*.tmp
*.swp
*.swo
*~

# ==================== REACT / NODE.JS ====================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Note: Some teams commit package-lock.json for consistency
# package-lock.json
yarn.lock

# Production build
build/
dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Testing
coverage/
.nyc_output/

# Misc
.DS_Store
Thumbs.db

# ==================== DATABASE ====================

# Ignore database runtime files, KEEP migration scripts
*.db-journal
*.db-wal
# DO NOT ignore *.sql - we need migration files!

# Database dumps (user-generated backups)
*.dump
*.backup

# ==================== SECURITY (NEVER COMMIT) ====================

# API Keys & Secrets
*.key
*.pem
*.p12
*.jks
secrets/
credentials/

# Specific secret files
application-secrets.properties
jwt.secret

# SendGrid / Email
sendgrid.key

# AWS credentials
.aws/

# ==================== IDE & OS ====================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

